{
  "colors": {
    "background-dark": "#2F1893",
    "heading": "#1E0E62",
    "text": "#15143966",
    "text-full": "#151439",
    "white": "#FFFFFF",
    "action-primary": "#E93A7D",
    "action-third": "#E93A7D",
    "grey-border": "#EBEAED",
    "grey-bg": "#F2F2F2"
  },
  "typography": {
    "font-family": "DM Sans",
    "h2-header": {
      "fontFamily": "DM Sans",
      "fontWeight": 700,
      "fontSize": "58px",
      "lineHeight": "70px",
      "letterSpacing": "-1px"
    },
    "h3-title": {
      "fontFamily": "DM Sans",
      "fontWeight": 700,
      "fontSize": "42px",
      "lineHeight": "52px",
      "letterSpacing": "-0.4px"
    },
    "h5-lead": {
      "fontFamily": "DM Sans",
      "fontWeight": 500,
      "fontSize": "22px",
      "lineHeight": "32px"
    },
    "article": {
      "fontFamily": "DM Sans",
      "fontWeight": 500,
      "fontSize": "18px",
      "lineHeight": "28px"
    },
    "paragraph": {
      "fontFamily": "DM Sans",
      "fontWeight": 400,
      "fontSize": "16px",
      "lineHeight": "26px"
    },
    "label": {
      "fontFamily": "DM Sans",
      "fontWeight": 700,
      "fontSize": "14px",
      "lineHeight": "26px",
      "letterSpacing": "2px",
      "textTransform": "uppercase"
    },
    "button-middle": {
      "fontFamily": "DM Sans",
      "fontWeight": 500,
      "fontSize": "18px",
      "lineHeight": "26px"
    }
  },
  "spacing": {
    "grid-width": "1170px",
    "columns": 12,
    "gutter": "30px"
  },
  "borderRadius": {
    "button": "100px",
    "image": "10px",
    "input": "10px"
  }
}
